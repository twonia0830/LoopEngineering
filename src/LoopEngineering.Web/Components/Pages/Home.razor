@page "/"
@implements IDisposable
@inject LoopRunner Runner
@inject ConfigStore Store
@inject LoopEngineering.Core.Issues.IGitHubIssueFetcher IssueFetcher
@inject IJSRuntime JS
@inject AccountQuotaService Quota
@inject ModelCatalogService Models
@inject AntigravityModelCatalog AgyModels

<PageTitle>Loop Engineering</PageTitle>

<header class="topbar">
    <h1>Loop Engineering</h1>
    <span class="status-pill @StatusClass(_snap.Status)">@StatusText(_snap.Status)</span>
    <div class="spacer"></div>
    <QuotaBadge />
    @if (_snap.IsActive)
    {
        <button class="btn danger" @onclick="Stop" disabled="@(_snap.Status == RunStatus.Stopping)">■ Stop</button>
    }
    else
    {
        <button class="btn primary" @onclick="Start">▶ Start</button>
    }
</header>

<main class="layout">
    @* ---------------- Configuration ---------------- *@
    <section class="panel config">
        <h2>Setup</h2>
        @if (_errors.Count > 0)
        {
            <div class="alert error">
                <ul>@foreach (var e in _errors) { <li>@e</li> }</ul>
            </div>
        }

        <fieldset disabled="@_snap.IsActive">
            <label>Goal / project name
                <input @bind="_config.GoalName" placeholder="e.g. TodoApi" />
                <small>Progress file: <code>@(ProgressFile.SanitizeFileName(_config.GoalName))_progress.md</code></small>
            </label>

            <div class="field">
                <span class="field-label">Goal description</span>
                <select @bind="_config.GoalSource">
                    <option value="@GoalSource.Text">Text</option>
                    <option value="@GoalSource.File">File</option>
                    <option value="@GoalSource.GitHubIssues">GitHub issues</option>
                </select>
                @switch (_config.GoalSource)
                {
                    case GoalSource.Text:
                        <textarea rows="5" @bind="_config.GoalDescription" placeholder="What should the agent build or fix?"></textarea>
                        break;
                    case GoalSource.File:
                        <div class="row">
                            <input @bind="_config.GoalFilePath" placeholder="C:\path\to\goal.md" />
                            <button class="btn small" @onclick="BrowseGoalFile">Browse…</button>
                        </div>
                        <small>The file is re-read every round, so you can refine it while the loop runs.</small>
                        break;
                    case GoalSource.GitHubIssues:
                        <textarea rows="4" @bind="_config.GoalIssueLinks" @bind:after="ClearIssueCheck"
                                  placeholder="@("https://github.com/owner/repo/issues/123\nhttps://github.com/owner/other-repo/issues/45")"></textarea>
                        <div class="row issue-actions">
                            <small>One issue per line (a link, or owner/repo#123). Title, description and comments are fetched when the run starts.</small>
                            <button class="btn small" @onclick="CheckIssues" disabled="@_checkingIssues">@(_checkingIssues ? "Checking…" : "Check issues")</button>
                        </div>
                        @if (_issueCheck is not null)
                        {
                            <ul class="issue-check">
                                @foreach (var line in _issueCheck)
                                {
                                    <li class="@(line.Ok ? "ok-text" : "err-text")">@(line.Ok ? "✓" : "✗") @line.Text</li>
                                }
                            </ul>
                        }
                        break;
                }
            </div>

            <div class="field">
                <span class="field-label">Result criteria</span>
                <div class="radio-row">
                    <label class="inline"><input type="radio" name="crit" checked="@(_config.CriteriaSource == CriteriaSource.Text)"
                                                 @onchange="() => _config.CriteriaSource = CriteriaSource.Text" /> Text</label>
                    <label class="inline"><input type="radio" name="crit" checked="@(_config.CriteriaSource == CriteriaSource.File)"
                                                 @onchange="() => _config.CriteriaSource = CriteriaSource.File" /> File</label>
                </div>
                @if (_config.CriteriaSource == CriteriaSource.Text)
                {
                    <textarea rows="5" @bind="_config.CriteriaText" placeholder="@("- All unit tests pass\n- README documents the API")"></textarea>
                }
                else
                {
                    <div class="row">
                        <input @bind="_config.CriteriaFilePath" placeholder="C:\path\to\criteria.md" />
                        <button class="btn small" @onclick="BrowseCriteriaFile">Browse…</button>
                    </div>
                    <small>The file is re-read every round.</small>
                }
            </div>

            <div class="row">
                <label>Max loops <input type="number" min="1" @bind="_config.MaxLoops" /></label>
                <label>Turn timeout (min) <input type="number" min="1" @bind="_config.TurnTimeoutMinutes" /></label>
                <label>Max failures in a row <input type="number" min="1" @bind="_config.MaxConsecutiveFailures" /></label>
            </div>

            <div class="field">
                <span class="field-label">Working folders</span>
                @if (_config.WorkingDirectories.Count == 0)
                {
                    <small>No folder yet. Add the repo(s) the agent should work in.</small>
                }
                @for (var i = 0; i < _config.WorkingDirectories.Count; i++)
                {
                    var index = i;
                    var dir = _config.WorkingDirectories[index];
                    <div class="folder-row">
                        @if (index == 0)
                        {
                            <span class="badge running" title="Session working directory; the progress file goes here unless a progress folder is set">primary</span>
                        }
                        else
                        {
                            <button class="btn small" title="Make primary" @onclick="() => MakePrimary(index)">↑</button>
                        }
                        <input value="@dir" @onchange="e => SetWorkingFolder(index, e.Value?.ToString())" />
                        @if (!Directory.Exists(dir))
                        {
                            <span class="badge fail">missing</span>
                        }
                        else if (IsGitRepo(dir))
                        {
                            <span class="badge ok">git</span>
                        }
                        <button class="btn small" title="Remove" @onclick="() => _config.WorkingDirectories.RemoveAt(index)">✕</button>
                    </div>
                }
                <button class="btn small" @onclick="AddWorkingFolder">+ Add Working Folder</button>
            </div>

            <label>Progress file folder
                <div class="row">
                    <input @bind="_config.ProgressDirectory" placeholder="(first working folder)" />
                    <button class="btn small" @onclick="BrowseProgressFolder">Browse…</button>
                </div>
                <small>Optional. Set it to keep @(ProgressFile.SanitizeFileName(_config.GoalName))_progress.md out of your repos.</small>
            </label>

            <div class="model-group">
                <h3>Worker</h3>
                <label>Runs on
                    <select @bind="_config.WorkerBackend" @bind:after="OnBackendsChanged">
                        <option value="@AgentBackend.Copilot">GitHub Copilot</option>
                        <option value="@AgentBackend.ClaudeCode">Claude Code</option>
                        <option value="@AgentBackend.Antigravity">Antigravity (Google)</option>
                    </select>
                </label>
                <ModelPicker Label="Model" @bind-Model="_config.Model" @bind-Effort="_config.ReasoningEffort"
                             Backend="_config.WorkerBackend" EmptyLabel="@DefaultLabel(_config.WorkerBackend)"
                             TokenVariable="@(_tokenFound ? _config.TokenEnvironmentVariable : null)"
                             AntigravityCliPath="@_config.AntigravityCliPath" IsolateAntigravity="_config.IsolateAntigravity" />
            </div>

            <div class="model-group">
                <h3>Evaluator</h3>
                <label>Runs on
                    <select @bind="_config.EvaluatorBackend" @bind:after="OnBackendsChanged">
                        <option value="@AgentBackend.Copilot">GitHub Copilot</option>
                        <option value="@AgentBackend.ClaudeCode">Claude Code</option>
                        <option value="@AgentBackend.Antigravity">Antigravity (Google)</option>
                    </select>
                </label>
                @{ var evaluatorInherits = _config.EvaluatorBackend == _config.WorkerBackend; }
                <ModelPicker Label="Model" @bind-Model="_config.EvaluatorModel" @bind-Effort="_config.EvaluatorReasoningEffort"
                             Backend="_config.EvaluatorBackend"
                             EmptyLabel="@(evaluatorInherits ? "Same as worker" : DefaultLabel(_config.EvaluatorBackend))"
                             EffortEmptyLabel="@(evaluatorInherits && string.IsNullOrWhiteSpace(_config.EvaluatorModel) ? "same as worker" : "default")"
                             InheritedModel="@(evaluatorInherits ? _config.Model : null)" ShowRefresh="false"
                             TokenVariable="@(_tokenFound ? _config.TokenEnvironmentVariable : null)"
                             AntigravityCliPath="@_config.AntigravityCliPath" IsolateAntigravity="_config.IsolateAntigravity" />
                <small class="group-note">Tip: a model from another provider, or another subscription, is less likely to share the worker's blind spots.</small>
            </div>

            <div class="model-group">
                <h3>Repo guide (AGENTS.md)</h3>
                <label class="inline">
                    <input type="checkbox" @bind="_config.UseAgentsMd" />
                    Keep an AGENTS.md in each working folder and give it to every round
                </label>
                @if (_config.UseAgentsMd)
                {
                    <label class="inline">
                        <input type="checkbox" @bind="_config.UpdateAgentsMdOnSuccess" />
                        Update it with durable learnings when the criteria are met
                    </label>
                    <small class="group-note">
                        Missing AGENTS.md files are written before round 1; existing ones are used as they are.
                        The file is a normal repo file: review and commit it so your team benefits too.
                    </small>
                    <label>Starting point file (optional)
                        <div class="row">
                            <input @bind="_config.AgentsMdStartingPointFile" placeholder="e.g. flow.md: entry points and main flows" />
                            <button class="btn small" @onclick="BrowseStartingPoint">Browse…</button>
                        </div>
                        <small>The AGENTS.md writer reads this first and traces the code from the entry points it names.</small>
                    </label>
                    <label class="inline">
                        <input type="checkbox" @bind="_config.RegenerateAgentsMd" />
                        Regenerate AGENTS.md even where it exists (next run only; the old one is kept as reference)
                    </label>
                    <label>Runs on
                        <select @bind="_config.AgentsMdBackend" @bind:after="OnBackendsChanged">
                            <option value="@AgentsMdBackendChoice.SameAsEvaluator">Same as evaluator</option>
                            <option value="@AgentsMdBackendChoice.Copilot">GitHub Copilot</option>
                            <option value="@AgentsMdBackendChoice.ClaudeCode">Claude Code</option>
                            <option value="@AgentsMdBackendChoice.Antigravity">Antigravity (Google)</option>
                        </select>
                    </label>
                    var guideBackend = _config.BackendFor(RoundPhase.Guide);
                    var guideInherits = guideBackend == _config.EvaluatorBackend;
                    <ModelPicker Label="Model that writes it" @bind-Model="_config.AgentsMdModel" @bind-Effort="_config.AgentsMdReasoningEffort"
                                 Backend="guideBackend"
                                 EmptyLabel="@(guideInherits ? "Same as evaluator" : DefaultLabel(guideBackend))"
                                 EffortEmptyLabel="@(guideInherits && string.IsNullOrWhiteSpace(_config.AgentsMdModel) ? "same as evaluator" : "default")"
                                 InheritedModel="@(guideInherits ? _config.ModelFor(RoundPhase.Evaluator) : null)" ShowRefresh="false"
                                 TokenVariable="@(_tokenFound ? _config.TokenEnvironmentVariable : null)"
                             AntigravityCliPath="@_config.AntigravityCliPath" IsolateAntigravity="_config.IsolateAntigravity" />
                }
            </div>

            <label>GitHub Copilot token environment variable
                <input @bind="_config.TokenEnvironmentVariable" @bind:after="OnTokenVariableChanged" />
                <small class="@(_tokenFound ? "ok-text" : (_config.UsesBackend(AgentBackend.Copilot) ? "err-text" : ""))">
                    @(_tokenFound ? "✓ Variable is set. Only this token is passed to the Copilot SDK."
                        : _config.UsesBackend(AgentBackend.Copilot) ? "✗ Variable not set. Set it to a GitHub token with Copilot access."
                        : "Not set. Only needed for Copilot roles and the credits header.")
                </small>
            </label>

            @if (_config.UsesBackend(AgentBackend.ClaudeCode))
            {
                <div class="model-group">
                    <h3>Claude Code</h3>
                    <label>Claude token environment variable
                        <input @bind="_config.ClaudeTokenEnvironmentVariable" @bind:after="RefreshClaudeStatus" />
                        <small class="@(_claudeTokenFound ? "ok-text" : "err-text")">
                            @(_claudeTokenFound ? "✓ Variable is set. Only this token is passed to Claude Code."
                                : "✗ Variable not set. Run `claude setup-token` and store the token in this variable.")
                        </small>
                    </label>
                    <label>Claude Code CLI path
                        <input @bind="_config.ClaudeCliPath" @bind:after="RefreshClaudeStatus" placeholder="(find claude on PATH)" />
                        <small class="@(_claudeCliError is null ? "ok-text" : "err-text")">@(_claudeCliError ?? $"✓ {_claudeCliPath}")</small>
                    </label>
                    <small class="group-note">
                        Claude Code runs with its own settings folder, so your personal CLAUDE.md, plugins, hooks and MCP servers stay out of the loop.
                        Copilot-only features (custom agents, skill folders) do not apply to Claude Code roles.
                    </small>
                </div>
            }

            @if (_config.UsesBackend(AgentBackend.Antigravity))
            {
                <div class="model-group">
                    <h3>Antigravity (Google)</h3>
                    <label>Antigravity CLI path
                        <input @bind="_config.AntigravityCliPath" @bind:after="OnAntigravitySettingsChanged" placeholder="(find agy on PATH)" />
                        <small class="@(_agyCliError is null ? "ok-text" : "err-text")">@(_agyCliError ?? $"✓ {_agyCliPath}")</small>
                    </label>
                    <label class="inline">
                        <input type="checkbox" @bind="_config.IsolateAntigravity" @bind:after="OnAntigravitySettingsChanged" />
                        Keep my personal ~/.gemini setup (GEMINI.md, plugins, MCP) out of the loop
                    </label>
                    <small class="group-note">
                        Sign-in: agy has no token option, so it uses its own saved Google sign-in (run <code>agy</code> once in a terminal).
                        That is unlike the Copilot and Claude roles, which only use the token from the variable you name.
                        @(AgyModels.Error is { } agyError ? $" Model list: {agyError}" : AgyModels.Models.Count > 0 ? $" Signed in: {AgyModels.Models.Count} models available." : "")
                        Edits by the evaluator and AGENTS.md writer are only discouraged by the prompt here (agy has no way to disable edit tools).
                    </small>
                </div>
            }

            <details open="@(_skillDirs.Length + _agentDirs.Length > 0 || _config.CustomAgents.Count > 0)">
                <summary>Skills &amp; agents</summary>

                <label>Skill directories (one per line)
                    <textarea rows="2" @bind="_skillDirs" placeholder="D:\skills  (each skill = sub folder with SKILL.md)"></textarea>
                </label>
                <label>Agent directories (one per line)
                    <textarea rows="2" @bind="_agentDirs" placeholder="D:\agents  (*.agent.md files)"></textarea>
                </label>

                <div class="field">
                    <span class="field-label">Inline custom agents</span>
                    @foreach (var agent in _config.CustomAgents)
                    {
                        <div class="agent-card">
                            <div class="row">
                                <input @bind="agent.Name" placeholder="name" />
                                <input @bind="agent.Description" placeholder="description (helps the model pick it)" />
                                <button class="btn small" @onclick="() => _config.CustomAgents.Remove(agent)">✕</button>
                            </div>
                            <textarea rows="3" @bind="agent.Prompt" placeholder="System prompt for this agent"></textarea>
                            <input value="@string.Join(", ", agent.Skills)" placeholder="skills to preload (comma separated)"
                                   @onchange="e => agent.Skills = SplitList(e.Value?.ToString(), ',')" />
                        </div>
                    }
                    <button class="btn small" @onclick="() => _config.CustomAgents.Add(new CustomAgentDefinition())">+ Add agent</button>
                </div>

                <label>Run worker as agent
                    <input @bind="_config.ActiveAgent" list="agent-names" placeholder="(default agent)" />
                    <datalist id="agent-names">
                        @foreach (var a in _config.CustomAgents.Where(a => !string.IsNullOrWhiteSpace(a.Name)))
                        {
                            <option value="@a.Name"></option>
                        }
                    </datalist>
                    <small>Name of an inline agent or one from the agent directories.</small>
                </label>

                <label class="inline">
                    <input type="checkbox" @bind="_config.EnableConfigDiscovery" />
                    Also let Copilot discover config (instructions, skills, MCP) from the working directory and ~/.copilot
                </label>
            </details>

            <label>Extra instructions for every round
                <textarea rows="3" @bind="_config.ExtraInstructions" placeholder="Optional"></textarea>
            </label>
        </fieldset>
    </section>

    @* ---------------- Monitor ---------------- *@
    <section class="panel monitor">
        <div class="stats">
            <div class="stat"><span class="label">Goal</span><span class="value">@(_snap.GoalName is "" ? "—" : _snap.GoalName)</span></div>
            <div class="stat"><span class="label">Round</span><span class="value">@_snap.CurrentRound / @_snap.MaxLoops</span></div>
            <div class="stat"><span class="label">Phase</span><span class="value">@(_snap.Phase == RoundPhase.None ? "—" : _snap.Phase.ToString())</span></div>
            <div class="stat"><span class="label">Elapsed</span><span class="value">@Elapsed()</span></div>
            <div class="stat" title="@(_snap.TotalUsage.IsEmpty ? "" : _snap.TotalUsage.ToString())">
                <span class="label">Tokens (run)</span>
                <span class="value">@(_snap.TotalUsage.IsEmpty ? "—" : TokenUsage.Format(_snap.TotalUsage.TotalTokens))</span>
                @if (!_snap.TotalUsage.IsEmpty)
                {
                    <span class="sub" title="@_snap.TotalUsage.ToString()">@(_snap.TotalUsage.AiCredits is { } credits ? $"{credits:0.###} credits" : $"{_snap.TotalUsage.PremiumRequests:0.##} premium req")@(_snap.TotalUsage.EstimatedCostUsd is { } usd ? $" · Claude ≈${usd:0.##}" : "") · @_snap.TotalUsage.UserRequests prompts</span>
                }
            </div>
        </div>
        <div class="progress"><div class="bar" style="width:@(ProgressPercent())%"></div></div>
        @if (_snap.CurrentActivity is not null)
        {
            <div class="activity"><span class="spinner"></span>@_snap.CurrentActivity</div>
        }

        <div class="subagents">
            <h3>Running sub-agents</h3>
            @if (_snap.ActiveSubagents.Count == 0)
            {
                <p class="muted">None right now.</p>
            }
            else
            {
                @foreach (var s in _snap.ActiveSubagents)
                {
                    <div class="subagent" title="@s.Description">
                        <span class="spinner"></span><b>@s.Name</b>
                        <span class="muted">@s.Phase · @ProgressFile.FormatDuration(DateTimeOffset.Now - s.StartedAt)</span>
                    </div>
                }
            }
        </div>

        <nav class="tabs">
            @foreach (var tab in new[] { "Live", "Rounds", "Progress file", "Log" })
            {
                <button class="@(_tab == tab ? "active" : "")" @onclick="() => SelectTab(tab)">@tab
                    @if (tab == "Rounds" && _snap.Rounds.Count > 0) { <span class="count">@_snap.Rounds.Count</span> }
                </button>
            }
        </nav>

        @switch (_tab)
        {
            case "Live":
                <pre class="output" @ref="_liveEl">@(_snap.LiveOutput is "" ? "Output of the running turn streams here." : _snap.LiveOutput)</pre>
                break;

            case "Rounds":
                @if (_snap.Rounds.Count == 0)
                {
                    <p class="muted">No rounds yet.</p>
                }
                else
                {
                    <div class="rounds">
                        <ul class="round-list">
                            @foreach (var r in _snap.Rounds)
                            {
                                <li class="@(SelectedRound?.Number == r.Number ? "selected" : "")" @onclick="() => _selectedRound = r.Number">
                                    <span>Round @r.Number</span>
                                    <span class="badge @RoundDetails.VerdictClass(r)">@RoundDetails.VerdictText(r)</span>
                                    @if (r.Evaluation?.Score is int sc) { <span class="muted">@sc</span> }
                                    @if (!r.Usage.IsEmpty) { <span class="muted tokens">@TokenUsage.Format(r.Usage.TotalTokens) tok</span> }
                                </li>
                            }
                        </ul>
                        @if (SelectedRound is { } sel)
                        {
                            <RoundDetails Round="sel" />
                        }
                    </div>
                }
                break;

            case "Progress file":
                <div class="progress-file">
                    <div class="row">
                        <code>@(_snap.ProgressFilePath ?? "(starts with the first run)")</code>
                        <button class="btn small" @onclick="LoadProgressFile">Reload</button>
                    </div>
                    <Markdown Text="@_progressContent" />
                </div>
                break;

            case "Log":
                <div class="log">
                    @foreach (var entry in _snap.Log.Reverse())
                    {
                        <div class="log-line @entry.Level"><span class="time">@entry.Time.LocalDateTime.ToString("HH:mm:ss")</span>@entry.Message</div>
                    }
                </div>
                break;
        }
    </section>
</main>

<PathPicker Visible="_pickerVisible" Mode="_pickerMode" Title="@_pickerTitle" InitialPath="@_pickerInitial"
            OnSelected="OnPicked" OnCancel="() => _pickerVisible = false" />

@code {
    private LoopConfig _config = new();
    private string _skillDirs = "";
    private string _agentDirs = "";
    private List<string> _errors = [];
    private bool _tokenFound;

    private LoopSnapshot _snap = new();
    private string _tab = "Live";
    private int? _selectedRound;
    private string? _progressContent;
    private ElementReference _liveEl;

    private volatile bool _dirty;
    private int _ticks;
    private Timer? _refreshTimer;

    private RoundResult? SelectedRound =>
        _snap.Rounds.FirstOrDefault(r => r.Number == _selectedRound) ?? _snap.Rounds.LastOrDefault();

    protected override void OnInitialized()
    {
        _config = Store.Load();
        if (string.IsNullOrWhiteSpace(_config.TokenEnvironmentVariable)) _config.TokenEnvironmentVariable = "COPILOT_LOOP_TOKEN";
        _skillDirs = string.Join(Environment.NewLine, _config.SkillDirectories);
        _agentDirs = string.Join(Environment.NewLine, _config.AgentDirectories);
        RefreshTokenStatus();
        RefreshClaudeStatus();
        AgyModels.Changed += OnModelsChanged;
        OnAntigravitySettingsChanged();
        Quota.TokenVariable = _config.TokenEnvironmentVariable;
        if (_tokenFound && Quota.Current.FetchedAt is null) _ = Quota.RefreshAsync(force: false);
        Models.Changed += OnModelsChanged;
        if (_tokenFound) _ = RefreshModels(force: false);

        _snap = Runner.GetSnapshot();
        Runner.Changed += OnRunnerChanged;
        // Runner events can fire many times per second while output streams; repaint at most ~3x/sec.
        _refreshTimer = new Timer(_ => Repaint(), null, TimeSpan.FromMilliseconds(300), TimeSpan.FromMilliseconds(300));
    }

    private void OnRunnerChanged() => _dirty = true;

    private void Repaint()
    {
        // Also repaint every ~1s while active so the elapsed timers move.
        var tick = ++_ticks % 3 == 0;
        if (!_dirty && !(tick && _snap.IsActive)) return;
        _dirty = false;
        _ = InvokeAsync(() =>
        {
            var wasActive = _snap.IsActive;
            _snap = Runner.GetSnapshot();
            if (wasActive && !_snap.IsActive && _tab == "Progress file") LoadProgressFile();
            StateHasChanged();
        });
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_tab == "Live" && _snap.IsActive)
        {
            try { await JS.InvokeVoidAsync("loopUi.scrollToBottom", _liveEl); }
            catch (JSDisconnectedException) { }
        }
    }

    private void Start()
    {
        _config.SkillDirectories = SplitList(_skillDirs, '\n');
        _config.AgentDirectories = SplitList(_agentDirs, '\n');
        _config.CustomAgents.RemoveAll(a => string.IsNullOrWhiteSpace(a.Name) && string.IsNullOrWhiteSpace(a.Prompt));

        _errors = _config.Validate();
        RefreshTokenStatus();
        if (!_tokenFound && _config.UsesBackend(AgentBackend.Copilot))
            _errors.Add($"Environment variable '{_config.TokenEnvironmentVariable}' is not set.");
        if (_config.UsesBackend(AgentBackend.ClaudeCode))
        {
            RefreshClaudeStatus();
            if (!_claudeTokenFound) _errors.Add($"Environment variable '{_config.ClaudeTokenEnvironmentVariable}' is not set (Claude token from `claude setup-token`).");
            if (_claudeCliError is not null) _errors.Add(_claudeCliError);
        }
        if (_config.UsesBackend(AgentBackend.Antigravity))
        {
            RefreshAntigravityStatus();
            if (_agyCliError is not null) _errors.Add(_agyCliError);
            else if (AgyModels.Error is { } agyError && AgyModels.Models.Count == 0) _errors.Add($"Antigravity: {agyError}");
        }
        foreach (var (role, id, phase) in new[]
                 {
                     ("Worker", _config.Model, RoundPhase.Worker),
                     ("Evaluator", _config.EvaluatorModel, RoundPhase.Evaluator),
                     ("AGENTS.md", _config.UseAgentsMd ? _config.AgentsMdModel : "", RoundPhase.Guide)
                 })
        {
            if (string.IsNullOrWhiteSpace(id)) continue;
            if (_config.BackendFor(phase) == AgentBackend.ClaudeCode)
            {
                if (ClaudeCodeModels.Find(id) is null) _errors.Add($"{role} model '{id}' is not a Claude model. Pick one from the list.");
                continue;
            }
            if (_config.BackendFor(phase) == AgentBackend.Antigravity)
            {
                if (AgyModels.Models.Count > 0 && AgyModels.Find(id) is null)
                    _errors.Add($"{role} model '{id}' is not available in Antigravity (see `agy models`).");
                continue;
            }
            if (Models.Models.Count == 0) continue;
            var model = Models.Find(id);
            if (model is null) _errors.Add($"{role} model '{id}' is not available to your account. Pick one from the list.");
            else if (!model.IsEnabled) _errors.Add($"{role} model '{model.Name}' is disabled by policy.");
        }
        if (_errors.Count > 0) return;

        try
        {
            Store.Save(_config);
            Quota.TokenVariable = _config.TokenEnvironmentVariable;
            Runner.Start(_config); // the runner keeps its own copy of the config

            // Regenerating is a one-off: don't let it rewrite (and lose learnings from) AGENTS.md on every later run.
            if (_config.RegenerateAgentsMd)
            {
                _config.RegenerateAgentsMd = false;
                Store.Save(_config);
            }
            _selectedRound = null;
            _progressContent = null;
            _tab = "Live";
        }
        catch (Exception ex)
        {
            _errors = [ex.Message];
        }
        _snap = Runner.GetSnapshot();
    }

    private void Stop()
    {
        Runner.Stop();
        _snap = Runner.GetSnapshot();
    }

    // ---------- models ----------

    private void OnModelsChanged() => _ = InvokeAsync(StateHasChanged);

    private static string DefaultLabel(AgentBackend backend) => backend switch
    {
        AgentBackend.ClaudeCode => "Default (Claude Code decides)",
        AgentBackend.Antigravity => "Default (Antigravity decides)",
        _ => "Default (Copilot decides)"
    };

    /// <summary>A model id from one backend means nothing to the other: clear models that don't fit after a switch.</summary>
    private void OnBackendsChanged()
    {
        bool Fits(string id, AgentBackend backend) => string.IsNullOrWhiteSpace(id) || backend switch
        {
            AgentBackend.ClaudeCode => ClaudeCodeModels.Find(id) is not null,
            AgentBackend.Antigravity => AgyModels.Models.Count == 0 || AgyModels.Find(id) is not null,
            _ => ClaudeCodeModels.Find(id) is null && AgyModels.Find(id) is null
        };

        if (!Fits(_config.Model, _config.WorkerBackend)) { _config.Model = ""; _config.ReasoningEffort = ""; }
        if (!Fits(_config.EvaluatorModel, _config.EvaluatorBackend)) { _config.EvaluatorModel = ""; _config.EvaluatorReasoningEffort = ""; }
        if (!Fits(_config.AgentsMdModel, _config.BackendFor(RoundPhase.Guide))) { _config.AgentsMdModel = ""; _config.AgentsMdReasoningEffort = ""; }
        RefreshClaudeStatus();
        OnAntigravitySettingsChanged();
    }

    // ---------- Antigravity ----------

    private string? _agyCliPath;
    private string? _agyCliError;

    private void RefreshAntigravityStatus()
    {
        try
        {
            _agyCliPath = AntigravityCli.ResolvePath(_config.AntigravityCliPath);
            _agyCliError = null;
        }
        catch (InvalidOperationException ex)
        {
            _agyCliPath = null;
            _agyCliError = ex.Message;
        }
    }

    /// <summary>Re-checks the CLI and (re)loads `agy models` when an Antigravity role is in use. Listing models is free.</summary>
    private void OnAntigravitySettingsChanged()
    {
        RefreshAntigravityStatus();
        if (_agyCliError is null && _config.UsesBackend(AgentBackend.Antigravity))
            _ = AgyModels.RefreshAsync(_config.AntigravityCliPath, _config.IsolateAntigravity);
    }

    // ---------- Claude Code ----------

    private bool _claudeTokenFound;
    private string? _claudeCliPath;
    private string? _claudeCliError;

    private void RefreshClaudeStatus()
    {
        _claudeTokenFound = ClaudeCli.ResolveToken(_config.ClaudeTokenEnvironmentVariable) is not null;
        try
        {
            _claudeCliPath = ClaudeCli.ResolvePath(_config.ClaudeCliPath);
