    private Task RefreshModels(bool force) => Models.RefreshAsync(_config.TokenEnvironmentVariable, force);

    // ---------- file / folder picker ----------

    private bool _pickerVisible;
    private PathPickerMode _pickerMode;
    private string _pickerTitle = "";
    private string? _pickerInitial;
    private Action<string>? _pickerTarget;

    private void OpenPicker(PathPickerMode mode, string title, string? initial, Action<string> target)
    {
        _pickerMode = mode;
        _pickerTitle = title;
        _pickerInitial = string.IsNullOrWhiteSpace(initial) ? _config.PrimaryWorkingDirectory : initial;
        _pickerTarget = target;
        _pickerVisible = true;
    }

    private void OnPicked(string path)
    {
        _pickerVisible = false;
        _pickerTarget?.Invoke(path);
    }

    private void BrowseGoalFile() =>
        OpenPicker(PathPickerMode.File, "Choose the goal file", _config.GoalFilePath, p => _config.GoalFilePath = p);

    private void BrowseCriteriaFile() =>
        OpenPicker(PathPickerMode.File, "Choose the criteria file", _config.CriteriaFilePath, p => _config.CriteriaFilePath = p);

    private void BrowseStartingPoint() =>
        OpenPicker(PathPickerMode.File, "Choose the starting point file (e.g. flow.md)", _config.AgentsMdStartingPointFile,
            p => _config.AgentsMdStartingPointFile = p);

    private void BrowseProgressFolder() =>
        OpenPicker(PathPickerMode.Folder, "Choose where to write the progress file", _config.ProgressDirectory, p => _config.ProgressDirectory = p);

    // ---------- working folders ----------

    private void AddWorkingFolder() =>
        OpenPicker(PathPickerMode.Folder, "Add a working folder", _config.WorkingDirectories.LastOrDefault(), p =>
        {
            if (!_config.WorkingDirectories.Contains(p, StringComparer.OrdinalIgnoreCase)) _config.WorkingDirectories.Add(p);
        });

    private void SetWorkingFolder(int index, string? value) =>
        _config.WorkingDirectories[index] = (value ?? "").Trim().Trim('"');

    private void MakePrimary(int index)
    {
        var dir = _config.WorkingDirectories[index];
        _config.WorkingDirectories.RemoveAt(index);
        _config.WorkingDirectories.Insert(0, dir);
    }

    private static bool IsGitRepo(string dir) =>
        Directory.Exists(Path.Combine(dir, ".git")) || File.Exists(Path.Combine(dir, ".git"));

    // ---------- GitHub issues ----------

    private sealed record IssueCheckLine(bool Ok, string Text);

    private List<IssueCheckLine>? _issueCheck;
    private bool _checkingIssues;

    private void ClearIssueCheck() => _issueCheck = null;

    /// <summary>Fetches each linked issue so problems (typos, private repos the token can't see) show before Start.</summary>
    private async Task CheckIssues()
    {
        _checkingIssues = true;
        var results = new List<IssueCheckLine>();
        try
        {
            foreach (var line in GitHubIssueRef.SplitLines(_config.GoalIssueLinks))
            {
                if (!GitHubIssueRef.TryParse(line, out var issueRef))
                {
                    results.Add(new(false, $"Not an issue link: {line}"));
                    continue;
                }
                try
                {
                    var issue = await IssueFetcher.FetchAsync(issueRef, _config.TokenEnvironmentVariable, CancellationToken.None);
                    results.Add(new(true, $"{issueRef} — {issue.Title} ({issue.State}, {issue.Comments.Count} comments)"));
                }
                catch (Exception ex)
                {
                    results.Add(new(false, ex.Message));
                }
            }
            if (results.Count == 0) results.Add(new(false, "No issue links entered."));
        }
        finally
        {
            _issueCheck = results;
            _checkingIssues = false;
        }
    }

    private void SelectTab(string tab)
    {
        _tab = tab;
        if (tab == "Progress file") LoadProgressFile();
    }

    private void LoadProgressFile()
    {
        var path = _snap.ProgressFilePath ?? (string.IsNullOrWhiteSpace(_config.EffectiveProgressDirectory) || string.IsNullOrWhiteSpace(_config.GoalName)
            ? null
            : new ProgressFile(_config.EffectiveProgressDirectory, _config.GoalName).Path);
        try
        {
            _progressContent = path is not null && File.Exists(path) ? File.ReadAllText(path) : "_No progress file yet._";
        }
        catch (IOException ex)
        {
            _progressContent = $"Could not read progress file: {ex.Message}";
        }
    }

    private void OnTokenVariableChanged()
    {
        RefreshTokenStatus();
        if (_snap.IsActive) return;
        Quota.TokenVariable = _config.TokenEnvironmentVariable;
        if (_tokenFound)
        {
            _ = Quota.RefreshAsync();
            _ = RefreshModels(force: true);
        }
    }

    private void RefreshTokenStatus() => _tokenFound = TokenResolver.Resolve(_config.TokenEnvironmentVariable) is not null;

    private static List<string> SplitList(string? text, char separator) =>
        (text ?? "").Split(separator, StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).ToList();

    private string Elapsed()
    {
        if (_snap.StartedAt is not { } start) return "—";
        return ProgressFile.FormatDuration((_snap.EndedAt ?? DateTimeOffset.Now) - start);
    }

    private int ProgressPercent()
    {
        if (_snap.MaxLoops == 0) return 0;
        if (_snap.Status == RunStatus.CriteriaMet) return 100;
        var done = _snap.Rounds.Count(r => r.Status != RoundStatus.Running);
        return Math.Min(100, done * 100 / _snap.MaxLoops);
    }

    private static string StatusText(RunStatus s) => s switch
    {
        RunStatus.Idle => "Idle",
        RunStatus.Running => "Running",
        RunStatus.Stopping => "Stopping…",
        RunStatus.CriteriaMet => "Criteria met",
        RunStatus.MaxLoopsReached => "Max loops reached",
        RunStatus.Stopped => "Stopped",
        RunStatus.Failed => "Failed",
        _ => s.ToString()
    };

    private static string StatusClass(RunStatus s) => s switch
    {
        RunStatus.Running or RunStatus.Stopping => "running",
        RunStatus.CriteriaMet => "ok",
        RunStatus.Failed => "fail",
        RunStatus.MaxLoopsReached => "warn",
        _ => ""
    };

    public void Dispose()
    {
        Runner.Changed -= OnRunnerChanged;
        Models.Changed -= OnModelsChanged;
        AgyModels.Changed -= OnModelsChanged;
        _refreshTimer?.Dispose();
    }
}
