@implements IDisposable
@inject ModelCatalogService Models
@inject AntigravityModelCatalog AgyModels

<div class="field">
    <span class="field-label">@Label</span>
    <div class="row model-row">
        @if (!IsClaude && Options.Count == 0 && !ListLoading)
        {
            @* No live list (not signed in, token not set or load failed): fall back to typing the id. *@
            <input value="@Model" @onchange="e => SetModel(e.Value?.ToString())" placeholder="@($"{EmptyLabel} (or type a model id)")" />
        }
        else
        {
            <select value="@Model" @onchange="e => SetModel(e.Value?.ToString())" disabled="@(!IsClaude && ListLoading && Options.Count == 0)">
                <option value="">@EmptyLabel</option>
                @if (!string.IsNullOrWhiteSpace(Model) && Find(Model) is null && Options.Count > 0)
                {
                    <option value="@Model">⚠ @Model (not available)</option>
                }
                @foreach (var m in Options)
                {
                    <option value="@m.Id" disabled="@(!m.IsEnabled)">
                        @m.Name@(m.HasPrices ? $" · {m.PriceLabel}" : "")@(m.IsEnabled ? "" : " (disabled by policy)")
                    </option>
                }
            </select>
        }
        @if (ShowRefresh && !IsClaude)
        {
            <button class="btn small" title="Reload the model list" @onclick="Refresh" disabled="@(ListLoading || (!IsAntigravity && TokenVariable is null))">
                @if (ListLoading) { <span class="spinner"></span> } else { <span>↻</span> }
            </button>
        }
    </div>
    <small>@Hint()</small>
</div>

<label>@EffortLabel
    <select value="@Effort" @onchange="e => EffortChanged.InvokeAsync(e.Value?.ToString() ?? string.Empty)" disabled="@(EffortOptions().Count == 0)">
        <option value="">@(IsAntigravity ? "set by the model variant (low / medium / high)" : EffortOptions().Count == 0 ? "not supported by this model" : EffortEmptyLabel)</option>
        @foreach (var effort in EffortOptions())
        {
            <option value="@effort">@effort</option>
        }
    </select>
</label>

@code {
    /// <summary>Used when no specific Copilot model is chosen; the runtime accepts these for most models.</summary>
    private static readonly IReadOnlyList<string> GenericEfforts = ["low", "medium", "high", "xhigh", "max"];

    /// <summary>Levels the Claude Code CLI's --effort flag accepts.</summary>
    private static readonly IReadOnlyList<string> ClaudeEfforts = ["low", "medium", "high", "max"];

    [Parameter] public string Label { get; set; } = "Model";
    [Parameter] public string EffortLabel { get; set; } = "Reasoning effort";
    [Parameter] public string Model { get; set; } = "";
    [Parameter] public EventCallback<string> ModelChanged { get; set; }
    [Parameter] public string Effort { get; set; } = "";
    [Parameter] public EventCallback<string> EffortChanged { get; set; }

    /// <summary>Which runtime the role uses; decides the model list.</summary>
    [Parameter] public AgentBackend Backend { get; set; } = AgentBackend.Copilot;

    /// <summary>Text of the empty option, e.g. "Default (Copilot decides)" or "Same as worker".</summary>
    [Parameter] public string EmptyLabel { get; set; } = "Default (Copilot decides)";
    [Parameter] public string EffortEmptyLabel { get; set; } = "default";

    /// <summary>Model whose efforts and prices apply while <see cref="Model"/> is empty (e.g. the worker's model).</summary>
    [Parameter] public string? InheritedModel { get; set; }

    /// <summary>Copilot token variable to load the list with; null when the variable isn't set.</summary>
    [Parameter] public string? TokenVariable { get; set; }

    /// <summary>Antigravity CLI path setting and isolation flag, used to reload `agy models`.</summary>
    [Parameter] public string AntigravityCliPath { get; set; } = "";
    [Parameter] public bool IsolateAntigravity { get; set; } = true;
    [Parameter] public bool ShowRefresh { get; set; } = true;

    private bool IsClaude => Backend == AgentBackend.ClaudeCode;
    private bool IsAntigravity => Backend == AgentBackend.Antigravity;

    private IReadOnlyList<ModelOption> Options => Backend switch
    {
        AgentBackend.ClaudeCode => ClaudeCodeModels.All,
        AgentBackend.Antigravity => AgyModels.Models,
        _ => Models.Models
    };

    private bool ListLoading => IsAntigravity ? AgyModels.IsLoading : !IsClaude && Models.IsLoading;

    private ModelOption? Find(string? id) => Backend switch
    {
        AgentBackend.ClaudeCode => ClaudeCodeModels.Find(id),
        AgentBackend.Antigravity => AgyModels.Find(id),
        _ => Models.Find(id)
    };

    private string EffectiveModel => string.IsNullOrWhiteSpace(Model) ? InheritedModel ?? "" : Model;

    protected override void OnInitialized()
    {
        Models.Changed += OnModelsChanged;
        AgyModels.Changed += OnModelsChanged;
    }

    private void OnModelsChanged() => _ = InvokeAsync(StateHasChanged);

    private Task Refresh() => IsAntigravity
        ? AgyModels.RefreshAsync(AntigravityCliPath, IsolateAntigravity, force: true)
        : TokenVariable is null ? Task.CompletedTask : Models.RefreshAsync(TokenVariable, force: true);

    private IReadOnlyList<string> EffortOptions() => IsAntigravity ? [] : Find(EffectiveModel) switch
    {
        { IsAuto: false } model => model.ReasoningEfforts,
        _ => IsClaude ? ClaudeEfforts : GenericEfforts
    };

    private async Task SetModel(string? value)
    {
        await ModelChanged.InvokeAsync(value ?? "");
        // Drop an effort the newly chosen model does not support.
        if (!string.IsNullOrEmpty(Effort) && !EffortOptions().Contains(Effort))
            await EffortChanged.InvokeAsync("");
    }

    private string Hint()
    {
        if (IsClaude)
        {
            var claude = ClaudeCodeModels.Find(EffectiveModel);
            if (claude is null) return "Runs on your Claude subscription. Prices after the name: API-equivalent USD per 1M tokens (input / output).";
            return $"{(string.IsNullOrWhiteSpace(Model) ? $"{claude.Name}: " : "")}API-equivalent USD per 1M tokens: input ${claude.InputCreditsPerMillion:#,0.##}" +
                   (claude.CachedInputCreditsPerMillion is { } c ? $", cached input ${c:#,0.##}" : "") +
                   $", output ${claude.OutputCreditsPerMillion:#,0.##}. On a subscription this counts against your plan's limits.";
        }

        if (IsAntigravity)
        {
            if (AgyModels.IsLoading && AgyModels.Models.Count == 0) return "Loading models from agy…";
            if (AgyModels.Error is not null && AgyModels.Models.Count == 0) return $"Could not list Antigravity models: {AgyModels.Error}";
            return $"Runs on your Google AI plan through agy ({AgyModels.Models.Count} models). agy reports tokens but no price.";
        }

        if (TokenVariable is null) return "Set the Copilot token variable to load the models your account can use.";
        if (Models.IsLoading && Models.Models.Count == 0) return "Loading models…";
        if (Models.Error is not null && Models.Models.Count == 0) return $"Could not load models: {Models.Error}";

        var model = Models.Find(EffectiveModel);
        var prefix = string.IsNullOrWhiteSpace(Model) && model is not null ? $"{model.Name}: " : "";
        if (model is { HasPrices: true })
            return $"{prefix}AI credits per 1M tokens: input {model.InputCreditsPerMillion:#,0.##}" +
                   (model.CachedInputCreditsPerMillion is { } cached ? $", cached input {cached:#,0.##}" : "") +
                   $", output {model.OutputCreditsPerMillion:#,0.##}.";
        if (model is { IsAuto: true }) return "Copilot picks a model per request.";
        return $"{Models.Models.Count} models available. Numbers after the name: input / output AI credits per 1M tokens.";
    }

    public void Dispose()
    {
        Models.Changed -= OnModelsChanged;
        AgyModels.Changed -= OnModelsChanged;
    }
}
